"""Example testing/evaluation environment settings.

Copy this file to ``local.py`` (same directory) and fill in your own paths:

    cp lib/test/evaluation/local.py.example lib/test/evaluation/local.py

``local.py`` is git-ignored and will never be committed.
"""
from lib.test.evaluation.environment import EnvSettings


def local_env_settings():
    ws = '/path/to/DINOTrack'          # root directory of this repository
    out = ws + '/output'

    settings = EnvSettings()

    settings.antiuav318_rgb_path = '/path/to/datasets/AntiUAV318-RGB'
    settings.antiuav410_path = '/path/to/datasets/antiuav410'
    settings.ard100_path = '/path/to/datasets/ARD100'
    settings.davis_dir = ''
    settings.drone_vs_bird_path = '/path/to/datasets/Drone-vs-Bird'
    settings.dutantiuavtrack_path = '/path/to/datasets/dutantiuav'
    settings.got10k_lmdb_path = ''
    settings.got10k_path = '/path/to/datasets/got10k'
    settings.got_packed_results_path = ''
    settings.got_reports_path = ''
    settings.itb_path = ''
    settings.lasot_extension_subset_path = '/path/to/datasets/lasot_extension_subset'
    settings.lasot_lmdb_path = ''
    settings.lasot_path = '/path/to/datasets/lasot'
    settings.network_path = out + '/test/networks'
    settings.nfs_path = ''
    settings.otb_path = ''
    settings.prj_dir = ws
    settings.result_plot_path = out + '/test/result_plots'
    settings.results_path = out + '/test/tracking_results'
    settings.save_dir = out
    settings.segmentation_path = out + '/test/segmentation_results'
    settings.tc128_path = ''
    settings.tn_packed_results_path = ''
    settings.tnl2k_path = '/path/to/datasets/tnl2k'
    settings.tpl_path = ''
    settings.trackingnet_path = '/path/to/datasets/trackingnet'
    settings.uav_anti_uav_path = '/path/to/datasets/UAV-Anti-UAV'
    settings.u2u_dt_path = '/path/to/datasets/U2U-DT'
    settings.uav_path = ''
    settings.vot18_path = ''
    settings.vot22_path = ''
    settings.vot_path = ''
    settings.youtubevos_dir = ''

    return settings
